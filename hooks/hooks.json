{
  "description": "Scope the team-of-agents code explorer when the plugin is enabled.",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^team-of-agents:code-explorer$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/claude-explorer-start-hook.mjs"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
